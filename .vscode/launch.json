{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ShopEase GUI (Mac/Windows)",
            "request": "launch",
            "mainClass": "com.shopease.ui.ShopEaseApp",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/sqlite-jdbc.jar"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Full System Test",
            "request": "launch",
            "mainClass": "com.shopease.FullSystemTest",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/sqlite-jdbc.jar"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Smoke Test",
            "request": "launch",
            "mainClass": "com.shopease.SmokeTest",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/sqlite-jdbc.jar"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}
